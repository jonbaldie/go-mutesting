#!/bin/sh
# Local mirror of .github/workflows/mutation.yml's pull-request mode, scoped to
# the diff against origin/master. CI retains a full-tree gate for code pushes to
# master. Hard-fails on escaped mutants, on a gate miss, and on any missing tool -
# no silent skips.
#
# Not opt-out by default. To enable this hook, run once:
#   git config core.hooksPath githooks
set -eu

ROOT_DIR=$(git rev-parse --show-toplevel)
cd "$ROOT_DIR"
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_QUARANTINE_PATH

require_tool() {
	tool="$1"
	hint="$2"
	if ! command -v "$tool" >/dev/null 2>&1; then
		printf 'FAIL: required tool "%s" not found on PATH.\n  install with: %s\n' "$tool" "$hint" >&2
		exit 1
	fi
}

require_tool go "https://go.dev/doc/install"

# Skip only when every pushed ref is a delete (no new commits to analyze).
# This is the one legitimate no-op case for a pre-push hook, not a silent
# skip of a check: a deleted ref has no diff to mutate.
ANY_UPDATE=0
HEAD_SHA=$(git rev-parse HEAD)
while read -r local_ref local_sha remote_ref remote_sha; do
	if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
		continue
	fi
	ANY_UPDATE=1
	if ! local_commit=$(git rev-parse "${local_sha}^{commit}" 2>/dev/null); then
		printf 'FAIL: pushed ref %s does not resolve to a commit and cannot be checked.\n' "$local_ref" >&2
		exit 1
	fi
	if [ "$local_commit" != "$HEAD_SHA" ]; then
		printf 'FAIL: pushed ref %s is not the checked-out HEAD and cannot be checked safely.\n' "$local_ref" >&2
		exit 1
	fi
done
if [ "$ANY_UPDATE" -eq 0 ]; then
	echo "pre-push: only ref deletions pushed, nothing to mutate."
	exit 0
fi

if ! git rev-parse --verify origin/master >/dev/null 2>&1; then
	printf 'FAIL: origin/master not found locally. Run: git fetch origin master\n' >&2
	exit 1
fi

if ! CHANGED_GO_FILES=$(git diff --name-only "origin/master...$HEAD_SHA" -- '*.go'); then
	printf 'FAIL: could not determine changed Go files against origin/master.\n' >&2
	exit 1
fi
if [ -z "$CHANGED_GO_FILES" ]; then
	echo "pre-push: no Go source changes in the pushed diff; mutation gate is not applicable."
	exit 0
fi

TMP_DIR=$(mktemp -d)
CHECKOUT_DIR="$TMP_DIR/checkout"
cleanup() {
	cd "$ROOT_DIR"
	git worktree remove --force "$CHECKOUT_DIR" >/dev/null 2>&1 || true
	rm -rf "$TMP_DIR"
}
trap cleanup EXIT

echo "pre-push: checking pushed HEAD in an isolated worktree..."
git worktree add --quiet --detach "$CHECKOUT_DIR" "$HEAD_SHA"
cd "$CHECKOUT_DIR"

echo "pre-push: running mutation testing scoped to the diff against origin/master..."
STATUS=0
GOMAXPROCS=1 GO_MUTESTING_WORKERS=1 ./scripts/check-change.sh || STATUS=$?

if [ "$STATUS" -eq 4 ]; then
	printf '\nFAIL: mutation quality gate not met (escaped mutants in the diff against origin/master).\n' >&2
	exit 1
elif [ "$STATUS" -ne 0 ]; then
	printf '\nFAIL: go-mutesting exited with status %s (tool error).\n' "$STATUS" >&2
	exit 1
fi

printf '\nmutation quality gate passed.\n'
